/* =========================
   GIFT ROOM
========================= */


.gifts{

min-height:80vh;

}


.giftBox{

background:rgba(255,255,255,.35);

padding:25px;

margin:20px 0;

border-radius:25px;

cursor:pointer;

transition:.4s;

box-shadow:0 0 20px rgba(255,105,180,.2);

}


.giftBox:hover{

transform:scale(1.05);

}


.box{

font-size:70px;

animation:bounce 2s infinite;

}


.giftBox h3{

margin-top:15px;

color:#ff4c94;

font-size:12px;

}


.progress{

width:100%;

height:15px;

background:white;

border-radius:20px;

margin-top:30px;

overflow:hidden;

}


#giftProgress{

height:100%;

width:0%;

background:#ff4c94;

transition:.5s;

}


@keyframes bounce{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-10px);

}

100%{

transform:translateY(0);

}

}