*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Press Start 2P', cursive;
    background:linear-gradient(#ffd6ec,#ffc2e2,#ffeaf6);
    height:100vh;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:90%;
    max-width:420px;
    text-align:center;
    background:rgba(255,255,255,.25);
    backdrop-filter:blur(8px);
    border-radius:25px;
    padding:30px;
    box-shadow:0 0 25px rgba(255,105,180,.4);
}

h1{
    color:#ff4f9a;
    font-size:20px;
    margin-bottom:20px;
    line-height:1.6;
}

.subtitle{
    font-size:10px;
    line-height:1.8;
    color:#555;
    margin-bottom:25px;
}

.characters{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:20px;
    font-size:55px;
    margin-bottom:25px;
    animation:float 2s infinite ease-in-out;
}

.heart{
    animation:pulse 1s infinite;
}

.qr img{
    width:170px;
    height:170px;
    border-radius:20px;
    background:white;
    padding:10px;
    margin:25px 0;
}

button{
    width:100%;
    padding:18px;
    border:none;
    border-radius:18px;
    background:#ff4f9a;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    transform:scale(1.05);
    background:#ff2f84;
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.2);}
    100%{transform:scale(1);}
}

@keyframes float{
    0%{transform:translateY(0);}
    50%{transform:translateY(-8px);}
    100%{transform:translateY(0);}
}